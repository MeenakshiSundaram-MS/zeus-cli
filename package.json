{
  "name": "zeus-cli",
  "version": "0.1.0",
  "description": "Zeus OSS CLI Agent (Ollama-first, extensible skills and tools)",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "bin": {
    "zeus": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node --experimental-strip-types src/cli.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "cli",
    "agent",
    "ollama",
    "ai",
    "skills",
    "tools",
    "research",
    "local-first"
  ],
  "author": "Zeus Contributors",
  "license": "MIT"
}
